{
  "name": "@chex/markify",
  "version": "1.0.1",
  "private": true,
  "description": "Extract page content as Markdown",
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run scripts/build.ts --watch",
    "lint": "oxlint --config ../../.oxlintrc.json --deny-warnings .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@chex/build-utils": "workspace:*",
    "@happy-dom/global-registrator": "20.10.2",
    "@types/bun": "1.3.14",
    "@types/turndown": "5.0.6",
    "chrome-types": "0.1.429",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
