{
  "name": "@chex/markify",
  "version": "1.0.1",
  "private": true,
  "description": "Extract page content as Markdown",
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run scripts/build.ts --watch",
    "lint": "oxlint --config ../../.oxlintrc.json --deny-warnings .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@chex/build-utils": "workspace:*",
    "@happy-dom/global-registrator": "20.11.12",
    "@types/bun": "1.4.0",
    "@types/turndown": "5.0.6",
    "chrome-types": "0.1.440",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
