{
  "name": "@chex/markify",
  "version": "1.0.1",
  "private": true,
  "description": "Extract page content as Markdown",
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run scripts/build.ts --watch",
    "lint": "oxlint --type-aware --type-check --deny-warnings .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^1.0.27",
    "@chex/build-utils": "workspace:*",
    "@happy-dom/global-registrator": "18.0.1",
    "@types/bun": "1.3.9",
    "@types/turndown": "5.0.6",
    "chrome-types": "0.1.415",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
