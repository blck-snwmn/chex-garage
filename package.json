{
  "name": "chex-garage",
  "private": true,
  "workspaces": [
    "extensions/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "changeset": "changeset",
    "version": "changeset version && bun run sync-manifest",
    "sync-manifest": "bun scripts/sync-manifest.ts",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/bun": "1.4.2",
    "chrome-types": "0.1.447",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "0.35.4",
    "turbo": "2.10.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "packageManager": "bun@1.4.2"
}
