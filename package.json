{
  "name": "chex-garage",
  "private": true,
  "workspaces": [
    "extensions/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "changeset": "changeset",
    "version": "changeset version && bun run sync-manifest",
    "sync-manifest": "bun scripts/sync-manifest.ts",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@types/bun": "1.3.14",
    "chrome-types": "0.1.438",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "0.35.3",
    "turbo": "2.10.8",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "bun@1.3.5"
}
